# syntax=docker/dockerfile:1.7

FROM node:24.16.0-alpine AS build
WORKDIR /workspace

COPY package.json package-lock.json ./
COPY angular.json tsconfig*.json ngsw-config.json ./
COPY build-plugins ./build-plugins
COPY src/main/webapp ./src/main/webapp

RUN npm ci
RUN npm run webapp:build:prod -- --progress=false

FROM nginx:1.29-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/target/classes/static/ /usr/share/nginx/html/

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --retries=10 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
