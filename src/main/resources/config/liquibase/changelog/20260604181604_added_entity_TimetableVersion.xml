<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity TimetableVersion.
    -->
    <changeSet id="20260604181604-1" author="jhipster">
        <createTable tableName="timetable_version">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version_number" type="integer">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="total_hard_conflicts" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="total_soft_penalty" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="average_student_gap" type="double">
                <constraints nullable="true" />
            </column>
            <column name="room_utilization" type="double">
                <constraints nullable="true" />
            </column>
            <column name="timetable_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="solver_job_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="timetable_version" columnName="created_at" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
