# Copy to .env for local Docker overrides. Do not commit real .env files.
POSTGRES_DB=UniScheduler
POSTGRES_USER=UniScheduler
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200

# The default compose stack uses PostgreSQL trust auth and JHipster's
# secret-samples profile for a local demo only. For any shared deployment,
# configure real secrets outside Git and update docker-compose.yml accordingly.
